# Private key for deployment (with ETH for gas on Base Sepolia)
# For LOCAL development with Anvil, use the default account #0:
# PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# For TESTNET, use your own funded wallet key:
PRIVATE_KEY=your_private_key_here

# RPC URLs — Base Sepolia (Chain ID: 84532)
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_SEPOLIA_RPC_FALLBACK_1=https://base-sepolia.drpc.org
BASE_SEPOLIA_RPC_FALLBACK_2=https://84532.rpc.thirdweb.com/

# Pyth feed IDs (optional override)
# Base Sepolia ETH/USD feed
PYTH_NATIVE_USD_FEED=

# Optional: Basescan API key for contract verification
# Required for `npx hardhat verify --network baseSepolia`
ETHERSCAN_API_KEY=

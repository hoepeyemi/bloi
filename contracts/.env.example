# Private key for deployment (with ETH for gas on Base Sepolia)
# For LOCAL development with Anvil, use the default account #0:
# PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# For TESTNET, use your own funded wallet key:
PRIVATE_KEY=your_private_key_here

# RPC URLs — Base Sepolia (Chain ID: 84532)
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_SEPOLIA_RPC_FALLBACK_1=https://base-sepolia.drpc.org
BASE_SEPOLIA_RPC_FALLBACK_2=https://84532.rpc.thirdweb.com/

# Pyth oracle contract on Base Sepolia
# https://docs.pyth.network/price-feeds/contract-addresses/evm
PYTH=0x8250f4aF4B972684F7b336503E2D6dFeDeB1487a

# Pyth feed IDs — same ID on every EVM chain
# ETH/USD: https://www.pyth.network/developers/price-feed-ids
PYTH_NATIVE_USD_FEED=0xff61491a931112ddf1bd8147cd1b641375f79f5825126d665480874634fd0ace

# Aave V3 Pool on Base Sepolia
# https://docs.aave.com/developers/deployed-contracts/v3-testnet-addresses
AAVE_POOL=0x07eA79F68B2B3df564D0A34F8e19D9B1e339814b

# Basescan API key for contract verification
# Get a free key at https://basescan.org/myapikey
BASESCAN_API_KEY=

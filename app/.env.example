# bloi Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# BLOCKCHAIN CONFIGURATION (Required)
# =============================================================================

# Chain ID: 84532 = Base Sepolia (primary testnet, supports Circle Gateway nanopayments)
NEXT_PUBLIC_CHAIN_ID=84532

# Default app network mode
NEXT_PUBLIC_NETWORK_MODE=testnet

# RPC URLs for Base Sepolia
# Fallback order: sepolia.base.org -> base-sepolia.drpc.org -> 84532.rpc.thirdweb.com
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_FALLBACK_1=https://base-sepolia.drpc.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_FALLBACK_2=https://84532.rpc.thirdweb.com/

# =============================================================================
# CONTRACT ADDRESSES (Required)
# Get these from your deployment output after deploying to Base Sepolia
# =============================================================================

NEXT_PUBLIC_INVOICE_NFT_ADDRESS=0x1045c1fFf861D9f6F6D00F30eCf6075832d998Ec
NEXT_PUBLIC_YIELD_VAULT_ADDRESS=0x271a64E069E683627C23712156EDC804ac6a2CD7
NEXT_PUBLIC_AGENT_ROUTER_ADDRESS=0xA8fDda52A8022610e94C49E54EF61D8ae9662BE0
NEXT_PUBLIC_PRIVACY_REGISTRY_ADDRESS=0xb0e21917954138e84681C3792b9B31D892Bb1670
NEXT_PUBLIC_PYTH_ORACLE_ADDRESS=0x69a23dC9Ba9e5C965beCeF191850E5Cea74954C3
NEXT_PUBLIC_AAVE_YIELD_ADDRESS=0xCE4E72C577031A96e4EAcA48028eE3d23C64eccE

# =============================================================================
# CIRCLE GATEWAY NANOPAYMENTS (Required for x402 payment flows)
# Docs: https://developers.circle.com/gateway/nanopayments
# =============================================================================

# Seller wallet address that receives USDC nanopayments
NEXT_PUBLIC_GATEWAY_SELLER_ADDRESS=

# Circle Gateway facilitator API (testnet)
GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com

# Seller private key used by the payment API route to sign/withdraw (server-side only)
GATEWAY_SELLER_PRIVATE_KEY=

# Server-side seller address (mirrors NEXT_PUBLIC_GATEWAY_SELLER_ADDRESS for server routes)
GATEWAY_SELLER_ADDRESS=

# =============================================================================
# ARC APP KIT (Send, Bridge, Swap, Unified Balance)
# Docs: https://docs.arc.io/app-kit
# Chain: Base Sepolia (Arc chain id: "Base_Sepolia")
# =============================================================================

# No additional server-side keys required for browser wallet flows.
# For Circle Wallets adapter (agent/server use), set in agent/.env

# =============================================================================
# AGENT CONFIGURATION (Required)
# =============================================================================

# WebSocket URL for agent communication
NEXT_PUBLIC_AGENT_WS_URL=ws://localhost:8080

# =============================================================================
# APP CONFIGURATION (Required)
# =============================================================================

# Public URL of your app (used for CORS and OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# WALLETCONNECT (Optional)
# =============================================================================

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# =============================================================================
# QUICKBOOKS INTEGRATION (Optional - only needed for QuickBooks import)
# =============================================================================

QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox

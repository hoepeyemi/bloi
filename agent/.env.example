# bloi Agent - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# RPC URL — Base Sepolia (Chain ID: 84532, supports Circle Gateway nanopayments)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Agent wallet private key (required for executing transactions and nanopayments)
# WARNING: Never commit real private keys to version control!
AGENT_PRIVATE_KEY=

# =============================================================================
# AI CONFIGURATION
# =============================================================================

# Anthropic API key (for AI explanations)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# WebSocket server port
WS_PORT=8080

# WebSocket authentication token (optional - leave empty for development)
# WS_AUTH_TOKEN=your-secret-token-here

# =============================================================================
# CONTRACT ADDRESSES - BASE SEPOLIA (Chain ID: 84532)
# Set these after deploying contracts to Base Sepolia
# =============================================================================

INVOICE_NFT_ADDRESS=0x1045c1fFf861D9f6F6D00F30eCf6075832d998Ec
YIELD_VAULT_ADDRESS=0x271a64E069E683627C23712156EDC804ac6a2CD7
AGENT_ROUTER_ADDRESS=0xA8fDda52A8022610e94C49E54EF61D8ae9662BE0
PYTH_ORACLE_ADDRESS=0x69a23dC9Ba9e5C965beCeF191850E5Cea74954C3

# =============================================================================
# CIRCLE GATEWAY NANOPAYMENTS (x402 protocol)
# Docs: https://developers.circle.com/gateway/nanopayments
# Chain: Base Sepolia — fastest deposit finality (~13-19 min via direct deposit)
# USDC on Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Get testnet USDC: https://faucet.circle.com
# =============================================================================

# Gateway API endpoint (testnet)
GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com

# Seller address that receives USDC from x402 payments
GATEWAY_SELLER_ADDRESS=

# Agent's Gateway auto-funding thresholds (in USDC)
# If gateway balance < GATEWAY_MIN_BALANCE, auto-deposit GATEWAY_DEPOSIT_AMOUNT
GATEWAY_MIN_BALANCE=0.1
GATEWAY_DEPOSIT_AMOUNT=1

# bloi app URL — used by the agent to fetch enriched invoice data via nanopayment
# The agent will call GET /api/payments (x402-gated) during each analysis cycle
BLOI_APP_URL=http://localhost:3000

# =============================================================================
# ARC APP KIT (Send, Bridge — Base Sepolia)
# Docs: https://docs.arc.io/app-kit
# The agent uses kit.send() via viem private key adapter for yield distribution.
# =============================================================================

# For Circle Wallets adapter (optional — uses AGENT_PRIVATE_KEY by default)
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=

# =============================================================================
# OPTIONAL: PRODUCTION DATA SOURCES
# =============================================================================

# Pyth Oracle address (for real-time price feeds on Base Sepolia)
# PYTH_ORACLE_ADDRESS=0x69a23dC9Ba9e5C965beCeF191850E5Cea74954C3

# Aave V3 yield source address on Base Sepolia
# AAVE_YIELD_ADDRESS=0xCE4E72C577031A96e4EAcA48028eE3d23C64eccE
